U_CUT1.3  /CUT_SENSE_W1  # ADR-129 D5 / ADR-051 s2.6 (cut 1 drive+sense; J_W1 pad 3 RF_FEED)
U_CUT1.4  UNASSIGNED  # OPEN-31 (part TODO(unverified); pad exists on the land, no net assigned)
U_CUT1.5  UNASSIGNED  # OPEN-31 (part TODO(unverified); pad exists on the land, no net assigned)
U_CUT1.6  UNASSIGNED  # OPEN-31 (part TODO(unverified); pad exists on the land, no net assigned)

