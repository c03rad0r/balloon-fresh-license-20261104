# --- U_LORA1280  (NiceRF LoRa1280, SX1280 12.5 dBm, ranging) - ADR-139
# ADR-139 replaced the E28-2G4M27SX on the BOARD; this block is the same
# change applied to the registry, pin for pin, from the remap table in
# tracker/hardware/swap_u_e28_to_lora1280.py. The /E28_* NET NAMES are
# retained deliberately: they are net names, not part names, and renaming
# them would invalidate every routed segment on the board for no
# electrical change. Pads 8/9 (RX_EN/TX_EN) do not exist on this part;
# OPEN-E28-EN is therefore CLOSED by ADR-139, not waived.
U_LORA1280.1  /E28_DIO2  # ADR-139 pin remap (E28 14 DIO2); net name retained from ADR-118
U_LORA1280.2  /E28_DIO3  # ADR-139 pin remap (E28 15 DIO3); net name retained from ADR-118
U_LORA1280.3  +3V3  # ADR-139 pin remap (E28 1 VCC)
U_LORA1280.4  GND  # ADR-139 pin remap (E28 2/7/10/16 -> L1280 4/10/11/12/14)
U_LORA1280.5  /SPI1_MISO  # ADR-123 (2.4GHz bus: U3+U_C+site D) + ADR-139 pin remap (E28 3)
U_LORA1280.6  /SPI1_MOSI  # ADR-123 (2.4GHz bus: U3+U_C+site D) + ADR-139 pin remap (E28 4)
U_LORA1280.7  /SPI1_SCK  # ADR-123 (2.4GHz bus: U3+U_C+site D) + ADR-139 pin remap (E28 5)
U_LORA1280.8  /E28_CS_N  # ADR-139 pin remap (E28 6 NSS_CTS); net name retained from ADR-118
U_LORA1280.9  UNASSIGNED  # ADR-139: the LoRa1280 ANTENNA pad - no net, ADR-137 (antenna at the module)
U_LORA1280.10  GND  # ADR-139 pin remap
U_LORA1280.11  GND  # ADR-139 pin remap
U_LORA1280.12  GND  # ADR-139 pin remap
U_LORA1280.13  /E28_RESET_N  # ADR-139 pin remap (E28 11 NRESET); net name retained from ADR-118
U_LORA1280.14  GND  # ADR-139 pin remap
U_LORA1280.15  /E28_BUSY  # ADR-139 pin remap (E28 12 BUSY); net name retained from ADR-118
U_LORA1280.16  /E28_DIO1  # ADR-139 pin remap (E28 13 DIO1); net name retained from ADR-118

