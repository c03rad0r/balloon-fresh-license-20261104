U_CUT2.2  GND  # ADR-129 D5 / ADR-051 s2.5 (cut 2 return)
U_CUT2.3  /CUT_SENSE_W2  # ADR-129 D5 / ADR-051 s2.6 (cut 2 drive+sense; J_W2 pad 3 RF_FEED)
U_CUT2.4  UNASSIGNED  # OPEN-31 (part TODO(unverified); pad exists on the land, no net assigned)
