# =====================================================================
# ADR-148 -- ANALOG SENSE.  Two ADS1115IDGS (C37593, VSSOP-10) on the EXISTING I2C bus,
# zero new MCU pins.  The channel map is machine-readable in
# tracker/hardware/v11_analog_channels.json; the generator AND the test both read it, so
# the sheet cannot drift from the assertion.
#
# PGA / FSR = +/-4.096 V (PGA code 1) on BOTH devices, LSB 125 uV [SBAS444E Table 7-1].
#   +/-2.048 V is too small: the documented cold-Voc fault drives a solar tap to 2.10 V
#   and would leave only 29 LSB of headroom.
#   +/-6.144 V cannot deliver full scale at VDD = 3.3 V [SBAS444E s7.3.3].
# =====================================================================

# --- U_ADC1  ADS1115IDGS, ADDR -> GND = 0x48.  CUT SENSE (v11 item 3).  DNP.
# NOT WIRED: the sense element is a 10 mOhm series shunt that belongs to item 3, and the
# ADS1115 input power-sequence qualification is BLOCKED
# (docs/analysis/OPEN-25-CUTTER-ADC-SEQUENCE.md).  SBAS444E s9.1.4: an unused analog input
# is tied to GND, which is what happens here.  DNP so the pads exist for item 3 without
# spending supply current on a device that measures nothing yet.  The CHANNEL ALLOCATION is
# pinned in the JSON so item 3 cannot silently choose a different one.
U_ADC1.1  GND  # SBAS444E Table 7-2: ADDR->GND = 1001000b = 0x48
U_ADC1.2  UNASSIGNED  # ALERT/RDY unused; SBAS444E s9.1.4 permits floating
U_ADC1.3  GND  # SBAS444E pin 3
U_ADC1.4  GND  # AIN0 RESERVED = cut-sense wing 1 (item 3). SBAS444E s9.1.4
U_ADC1.5  GND  # AIN1 RESERVED = cut-sense wing 2 (item 3). SBAS444E s9.1.4
U_ADC1.6  GND  # AIN2 RESERVED = cut-sense wing 3 (item 3). SBAS444E s9.1.4
U_ADC1.7  GND  # AIN3 RESERVED = cut-sense wing 4 (item 3). SBAS444E s9.1.4
U_ADC1.8  +3V3  # VDD; SBAS444E s5.3 operating 2..5.5 V
U_ADC1.9  /I2C_SDA  # shared baro bus (U1.39)
U_ADC1.10  /I2C_SCL  # shared baro bus (U1.38)

# --- U_ADC2  ADS1115IDGS, ADDR -> VDD = 0x49.  THE FOUR RAIL-MONITOR CHANNELS.  Fitted.
# All four at ratio 0.2198582, so ONE calibration constant and ONE PGA setting serve all.
U_ADC2.1  +3V3  # SBAS444E Table 7-2: ADDR->VDD = 1001001b = 0x49
U_ADC2.2  UNASSIGNED  # ALERT/RDY unused; SBAS444E s9.1.4
U_ADC2.3  GND  # SBAS444E pin 3
U_ADC2.4  /SCAP_ADC  # AIN0 = /VSCAP. CLOSES the v10 two-pad orphan.
U_ADC2.5  /W1_SOLAR_SENSE  # AIN1 = /W1_SOLAR_P (12-cell stack top)
U_ADC2.6  /W2_SOLAR_SENSE  # AIN2 = /W1_SOLAR_N (9-cell tap)
U_ADC2.7  /W3_SOLAR_SENSE  # AIN3 = /W2_SOLAR_N (6-cell tap)
U_ADC2.8  +3V3  # VDD
U_ADC2.9  /I2C_SDA
U_ADC2.10  /I2C_SCL

# --- decoupling: SBAS444E s10.2 requires at least 0.1 uF at each VDD pin
C_ADC1.1  +3V3
C_ADC1.2  GND
C_ADC2.1  +3V3
C_ADC2.2  GND

# --- I2C PULL-UPS.  MEASURED on hub_board_v10.kicad_pcb: the bus has NONE.  The only pads
# on /I2C_SCL and /I2C_SDA are U1.38/U1.39 and U6.7/U6.8 -- no resistors at all.  ADR-145
# states the bus "already exists and is already routed"; routed, yes, but with no pull-ups
# two more devices cannot drive it.  Zero DC draw at idle (both lines high).
R_PU1.1  +3V3
R_PU1.2  /I2C_SCL
R_PU2.1  +3V3
R_PU2.2  /I2C_SDA

# =====================================================================
# /VSCAP DIVIDER.  R_DIV1/R_DIV2 exist on v10 as 1 M / 1 M (ratio 0.5).  v11 changes their
# VALUES to 2.2 M / 620 k (ratio 0.2198582) and splits the midpoint from the ADC net with
# a protection resistor.  A 0.5 ratio puts 4.64 V on the ADS1115 pin at the documented
# 9.28 V un-clamped fault, against an absolute maximum of VDD+0.3 = 3.6 V -- the inherited
# divider would destroy the ADC in exactly the fault the board exists to observe.
# Total stays within ADR-047 s6's budget: 10.3 uW at 5.4 V against the recorded 14.6 uW.
# =====================================================================
# --- R_DIV1  2.2 M upper
R_DIV1.1  /VSCAP  # ADR-129 D1 / ADR-006 (supercap ADC divider, upper) -- VALUE 2.2M
R_DIV1.2  /SCAP_DIV  # ADR-148: was /SCAP_ADC on v10; now the divider midpoint

# --- R_DIV2  620 k lower
R_DIV2.1  /SCAP_DIV  # ADR-148: was /SCAP_ADC on v10
R_DIV2.2  GND  # ADR-129 D1 / ADR-006 (lower) -- VALUE 620k

# --- R_PROT1  input protection; bounds pin current. See docs/fab/V11-ADC-INPUT-PROTECTION.md
R_PROT1.1  /SCAP_DIV
R_PROT1.2  /SCAP_ADC

# --- C_DIV1  first-order RC at the pin + sample-and-hold reservoir (SBAS444E s9.1.5)
C_DIV1.1  /SCAP_ADC
C_DIV1.2  GND

# =====================================================================
# SOLAR-INPUT DIVIDERS.  The four wings are in SERIES, so only THREE independent nodes
# exist: /W1_SOLAR_P (12 cells above GND), /W1_SOLAR_N (9), /W2_SOLAR_N (6).  Wing
# voltages 1-3 are DIFFERENCES of adjacent measured nodes.  Wing 4 is /W3_SOLAR_N to GND
# and is NOT directly measurable: ADR-148 spent all eight channels (4 cut + VSCAP + 3 solar).
# 220 k / 62 k -> ratio 0.2198582, identical to the VSCAP divider.
# At night the string sits at 0 V and these draw NOTHING; the load exists only while the
# array is illuminated.  Daytime 34 uA per divider against the array's 0.4-1.2 A.
# =====================================================================

# --- /W1_SOLAR_P -> AIN1   (stack top, 12 cells)
R_SOL1.1  /W1_SOLAR_P  # 220k upper
R_SOL1.2  /W1_SOLAR_DIV
R_PROT2.1  /W1_SOLAR_DIV
R_PROT2.2  /W1_SOLAR_SENSE
R_SOL2.1  /W1_SOLAR_DIV  # 62k lower
R_SOL2.2  GND
C_SOL1.1  /W1_SOLAR_SENSE
C_SOL1.2  GND

# --- /W1_SOLAR_N -> AIN2   (9-cell tap; this node IS W2_P)
R_SOL3.1  /W1_SOLAR_N  # 220k upper
R_SOL3.2  /W2_SOLAR_DIV
R_PROT3.1  /W2_SOLAR_DIV
R_PROT3.2  /W2_SOLAR_SENSE
R_SOL4.1  /W2_SOLAR_DIV  # 62k lower
R_SOL4.2  GND
C_SOL2.1  /W2_SOLAR_SENSE
C_SOL2.2  GND

# --- /W2_SOLAR_N -> AIN3   (6-cell tap; this node IS W3_P)
R_SOL5.1  /W2_SOLAR_N  # 220k upper
R_SOL5.2  /W3_SOLAR_DIV
R_PROT4.1  /W3_SOLAR_DIV
R_PROT4.2  /W3_SOLAR_SENSE
R_SOL6.1  /W3_SOLAR_DIV  # 62k lower
R_SOL6.2  GND
C_SOL3.1  /W3_SOLAR_SENSE
C_SOL3.2  GND


# UNASSIGNED pins on this board: 57 -> J_HUB_PV.3, U1."", U1.15, U1.16, U1.26, U1.27, U1.28, U1.29, U1.30, U1.35, U2.9, U2.10, U3.9, U3.10, U3.16, U3.17, U5.5, U5.11, U5.13, U5.14, U5.15, U5.16, U5.17, U5.18, U7.4, U_C.9, U_C.10, U_C.16, U_C.17, U_CUT1.4, U_CUT1.5, U_CUT1.6, U_CUT2.4, U_CUT2.5, U_CUT2.6, U_CUT3.4, U_CUT3.5, U_CUT3.6, U_CUT4.4, U_CUT4.5, U_CUT4.6, U_HUB_CVT."", U_HUB_CVT.4, U_HUB_CVT.5, U_HUB_CVT.6, U_HUB_CVT.7, U_HUB_CVT.8, U_HUB_CVT.9, U_HUB_CVT.10, U_HUB_CVT.11, U_HUB_CVT.12, U_HUB_CVT.13, U_HUB_CVT.14, U_HUB_CVT.15, U_HUB_CVT.16, U_HUB_CVT.17, U_LORA1280.9
