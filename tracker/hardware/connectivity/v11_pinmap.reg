U1.5  /SPI2_MOSI  # ADR-123 (433MHz bus: F33 alone)
U1.6  /SPI2_MISO  # ADR-123 (433MHz bus: F33 alone)
U1.7  /F33_CS_N  # v9 netlist (F33 control)
U1.8  /SPI1_MOSI  # ADR-123 (2.4GHz bus: U3+U_C+E28)
U1.9  /SPI1_MISO  # ADR-123 (2.4GHz bus: U3+U_C+E28)
U1.10  /E28_CS_N  # ADR-118 + E28 sidecar pin map
U1.11  /E28_DIO2  # ADR-118 + E28 sidecar pin map
U1.12  /F33_BUSY  # v9 netlist (F33 control)
U1.13  /USB_DN  # ADR-121 (J_PROG)
U1.14  /USB_DP  # ADR-121 (J_PROG)
U1.15  UNASSIGNED  # SEE connectivity/OPEN-ITEMS.md
U1.16  UNASSIGNED  # SEE connectivity/OPEN-ITEMS.md
U1.17  /F33_IRQ  # v9 netlist (F33 control)
U1.18  /F33_RESET_N  # v9 netlist (F33 control)
